VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: lets the production website render staging public-token links
# such as /summary/:token?env=staging without creating a separate staging URL.
VITE_STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
VITE_STAGING_SUPABASE_ANON_KEY=your-staging-publishable-or-anon-key

SHADCNBLOCKS_API_KEY=sk_live_your_key_here

# PostHog
VITE_POSTHOG_KEY=phc_your_key_here
VITE_POSTHOG_HOST=https://h.hemo-scd.com
