# Hosted builds should use a hosted staging or production project. For physical
# device local testing, replace <MAC_LAN_IP> and <LOCAL_PUBLISHABLE_KEY> with
# values shown by `supabase status`.
EXPO_PUBLIC_SUPABASE_URL=http://<MAC_LAN_IP>:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=<LOCAL_PUBLISHABLE_KEY>
