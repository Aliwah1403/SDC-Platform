# Copy to an ignored local file such as supabase/.env.staging before setting
# hosted staging secrets. Do not commit real secrets.
#
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY to Edge Functions automatically.

# Public link base. Per current staging decision, use the production website.
# HEMO_APP_ENV makes emailed links add ?env=staging for the shared website.
HEMO_APP_ENV=staging
WEB_BASE_URL=https://hemo-scd.com

# AI functions
ANTHROPIC_API_KEY=

# Health Summary queueing
TRIGGER_SECRET_KEY=

# Push notifications.
# Current staging decision: reuse Novu Production environment/workflows.
NOVU_API_KEY=
SYSTEM_PUSH_WEBHOOK_SECRET=

# Optional / later:
# Keep Resend unset for first staging build. Configure after the build works.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
CONTACT_WEBHOOK_SECRET=
WAITLIST_WEBHOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=

# Optional form enrichment.
ABSTRACT_API_KEY=
