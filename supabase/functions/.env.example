# Copy to supabase/functions/.env. This example contains no secrets.
# Safe mode intentionally leaves outbound email, push, and webhook providers
# unconfigured until each integration is deliberately enabled for local testing.
LOCAL_SAFE_MODE=true
WEB_BASE_URL=http://127.0.0.1:5173
HEMO_APP_ENV=local

# Optional AI/function testing
ANTHROPIC_API_KEY=
ABSTRACT_API_KEY=
TRIGGER_SECRET_KEY=

# Care-location enrichment. Keep the API key server-side; never use an
# EXPO_PUBLIC_ prefix. Leave disabled when no Geoapify project is configured.
CARE_LOCATION_GEOAPIFY_ENABLED=false
GEOAPIFY_API_KEY=
GEOAPIFY_RATE_LIMIT_SALT=

# Optional Google Gemini Search grounding. Gemini is primary when enabled and
# does not read or write the Geoapify cache. Keep all values server-only.
CARE_LOCATION_GEMINI_ENABLED=false
CARE_LOCATION_GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
CARE_LOCATION_GEMINI_RATE_LIMIT_SALT=

# Leave blank in safe mode. Add only when deliberately testing that provider.
NOVU_API_KEY=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=
CONTACT_WEBHOOK_SECRET=
SYSTEM_PUSH_WEBHOOK_SECRET=
COMMUNITY_PUSH_WEBHOOK_SECRET=
WAITLIST_WEBHOOK_SECRET=
REGISTERED_WEBHOOK_SECRET=
SEND_EMAIL_HOOK_SECRET=
